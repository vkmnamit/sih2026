# Supabase Authentication (Required for /api/auth routes)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
supabase-project-id=https://your-project-id.supabase.co
supabase-anon-key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
supabase-service-key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenRouter LLM (Required for /api/ask, /api/cards, /api/reels metadata)
